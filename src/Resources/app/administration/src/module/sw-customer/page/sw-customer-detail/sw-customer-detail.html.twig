{% block sw_customer_detail_content_tab_after %}
    {% parent %}

    <sw-tabs-item
            v-if="isPurchasedProductsTabEnabled"
            class="sw-customer-detail__tab-purchased-products"
            :route="{ name: 'sw.customer.detail.purchasedProducts', params: { id: $route.params.id } }"
            :title="$tc('modestox-reorder-insights.customerDetail.tabTitle')">
        {{ $tc('modestox-reorder-insights.customerDetail.tabTitle') }}
    </sw-tabs-item>
{% endblock %}